{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bvp/types",
    "description": "BVP Types：場・級別・天候・決まり手などの Enum と共通インターフェース | Shared enums and contracts for BVP",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "shimomo",
            "email": "bvp@shimomo.net"
        }
    ],
    "support": {
        "issues": "https://github.com/boatracevibeproject/types/issues",
        "source": "https://github.com/boatracevibeproject/types"
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.8 || ^13.0",
        "squizlabs/php_codesniffer": "^4.0",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "BVP\\Types\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BVP\\Types\\Tests\\": "tests/"
        }
    },
    "prefer-stable": true
}
